{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake Configure -- Linux GCC Debug",
      "type": "shell",
      "command": "nix",
      "args": [
        "develop",
        "--command",
        "cmake",
        "--preset",
        "linux-gcc-debug"
      ],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "CMake Build -- Linux GCC Debug",
      "type": "shell",
      "command": "nix",
      "args": [
        "develop",
        "--command",
        "cmake",
        "--build",
        "build/linux-gcc-debug"
      ],
      "group": "build",
      "problemMatcher": []
    }
  ]
}